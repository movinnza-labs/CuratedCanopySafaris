# Canonical URLs, the sitemap and structured data always use https://curatedcanopysafaris.com (lib/data/site.ts),
# so staging pages point search engines at the live site.

# Any host other than curatedcanopysafaris.com (staging, previews) is sent "X-Robots-Tag: noindex, nofollow" by proxy.ts.
# Set to "on" only if the live site is ever served behind a proxy that hides the real hostname.
# SITE_INDEXING=on

# Where enquiry-form submissions are POSTed as JSON (e.g. a Formspree, Make, Zapier or n8n webhook).
# If unset, the form offers the visitor pre-filled email / WhatsApp messages instead.
ENQUIRY_WEBHOOK_URL=

# Easebuzz payment gateway behind the "Pay Now" page (/pay). Key and salt come from the Easebuzz dashboard.
# Keep these server-side only (never prefix with NEXT_PUBLIC_). EASEBUZZ_ENV is "test" (testpay.easebuzz.in) or "prod".
EASEBUZZ_KEY=
EASEBUZZ_SALT=
EASEBUZZ_ENV=test

# QA only: preview departure schedules as of a given date (YYYY-MM-DD). Leave unset in production.
# DEPARTURES_AS_OF=2026-05-01
