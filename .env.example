# Public URL of the deployed site (used for canonical URLs, sitemap and structured data).
NEXT_PUBLIC_SITE_URL=https://curatedcanopysafaris.com

# Where enquiry-form submissions are POSTed as JSON (e.g. a Formspree, Make, Zapier or n8n webhook).
# If unset, the form offers the visitor pre-filled email / WhatsApp messages instead.
ENQUIRY_WEBHOOK_URL=

# QA only: preview departure schedules as of a given date (YYYY-MM-DD). Leave unset in production.
# DEPARTURES_AS_OF=2026-05-01
